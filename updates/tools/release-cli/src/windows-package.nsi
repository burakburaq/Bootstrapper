; Generated by release-cli. This package is invoked only by the verified helper.
Unicode true
RequestExecutionLevel admin
SilentInstall silent
SetCompressor /SOLID lzma
Name "@DISPLAY_NAME@"
OutFile "package.exe"
VIProductVersion "@VERSION_FIXED@"
VIAddVersionKey /LANG=1033 "ProductName" "@DISPLAY_NAME@"
VIAddVersionKey /LANG=1033 "CompanyName" "@PUBLISHER@"
VIAddVersionKey /LANG=1033 "ProductVersion" "@VERSION@"
VIAddVersionKey /LANG=1033 "FileVersion" "@VERSION@"
VIAddVersionKey /LANG=1033 "FileDescription" "Verified staged application package"
VIAddVersionKey /LANG=1033 "LegalCopyright" "@PUBLISHER@"
!include "FileFunc.nsh"
!include "LogicLib.nsh"
Var Mode
Var Stage
Var Active
Var Backup
Function .onInit
  SetRegView 64
  SetShellVarContext all
  ${GetParameters} $R0
  ${GetOptions} $R0 "/BAYKUS_MODE=" $Mode
  ${GetOptions} $R0 "/BAYKUS_STAGE=" $Stage
  ${GetOptions} $R0 "/BAYKUS_ACTIVE=" $Active
  ${If} $Stage == ""
    SetErrorLevel 10
    Quit
  ${EndIf}
  ${If} $Mode != "stage"
  ${AndIf} $Mode != "activate"
    SetErrorLevel 11
    Quit
  ${EndIf}
  ${If} $Mode == "activate"
  ${AndIf} $Active != "$PROGRAMFILES64\@PRODUCT_DIRECTORY@"
    SetErrorLevel 12
    Quit
  ${EndIf}
FunctionEnd
Section
  ${If} $Mode == "stage"
    ; ONLY extraction. No registry, active-file, shortcut, service or runtime changes.
    IfFileExists "$Stage\*.*" fail_stage
    ClearErrors
@EXTRACTION@
    IfErrors fail_stage
    SetErrorLevel 0
    Goto done
    fail_stage:
      SetErrorLevel 20
      Goto done
  ${EndIf}
  ; The helper has verified the whole staging tree and closed all product processes.
  StrCpy $Backup "$Stage\..\backup"
  ; An interrupted attempt may already have moved the old product to backup.
  IfFileExists "$Backup\*.*" no_previous
  ClearErrors
  IfFileExists "$Active\*.*" 0 no_previous
    Rename "$Active" "$Backup"
    IfErrors fail_activate
  no_previous:
  CreateDirectory "$Active"
  CopyFiles /SILENT "$Stage\*.*" "$Active"
  IfErrors fail_activate
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_ID@" "DisplayName" "@DISPLAY_NAME@"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_ID@" "Publisher" "@PUBLISHER@"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_ID@" "DisplayVersion" "@VERSION@"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_ID@" "InstallLocation" "$Active"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_ID@" "DisplayIcon" '$\"$Active\@EXECUTABLE@$\",0'
@MAINTENANCE_REGISTRATION@
  WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_ID@" "NoRepair" 1
  IfErrors fail_activate
  SetErrorLevel 0
  Goto done
  fail_activate:
    ; No unverified rollback: retain backup and let the journal reconcile on restart.
    SetErrorLevel 30
  done:
SectionEnd
