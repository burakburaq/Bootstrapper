UPDATE_PROJECT=updates-staging
UPDATE_DOMAIN=updates.example.com
UPDATE_TLS_EMAIL=operator@example.com
UPDATE_HTTP_PORT=80
UPDATE_HTTPS_PORT=443
# Enable for native Windows installation authorization; provide its separate secret/public trust.
UPDATE_INSTALL_AUTHORIZATION=0
# UPDATE_AUTHORIZATION_KEY_ID=install-auth-1
# Pin these infrastructure images by digest for a real environment.
UPDATE_POSTGRES_IMAGE=postgres:16-bookworm
UPDATE_PROXY_IMAGE=caddy:2-alpine
UPDATE_ROUTER_IMAGE=haproxy:3.2-alpine
