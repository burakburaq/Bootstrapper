{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleDetection": "legacy",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true,
    "rootDir": "ui",
    "outDir": "build/ui"
  },
  "include": ["ui/app.ts", "ui/native.d.ts"]
}
